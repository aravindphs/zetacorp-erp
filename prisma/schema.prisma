// NSquare ERP — Prisma schema (spec §18–§45)
//
// Conventions:
//   * PostgreSQL with UUID primary keys generated by the database
//     (`gen_random_uuid()`), never auto-increment integers (§18).
//   * snake_case columns / plural snake_case tables via @map / @@map (§18).
//   * Common columns on every *business* table (§19): id, created_at,
//     updated_at, created_by, updated_by, deleted_at, deleted_by, is_deleted.
//   * Append-only log tables are immutable (§40) and therefore omit
//     updated_at and the soft-delete columns.
//   * Audit-actor columns (created_by/updated_by/deleted_by) are indexed UUID
//     scalars; foreign-key constraints are enforced on true domain relations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
}

enum CustomerType {
  INDIVIDUAL
  BUSINESS
  GOVERNMENT
  DEALER
  DISTRIBUTOR
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  BLACKLISTED
  ARCHIVED
}

enum AddressType {
  BILLING
  SHIPPING
  OFFICE
  WAREHOUSE
  OTHER
}

enum ContactMethod {
  PHONE
  EMAIL
  WHATSAPP
}

enum ProductStatus {
  ACTIVE
  OUT_OF_STOCK
  DISCONTINUED
  ARCHIVED
}

enum InventoryTransactionType {
  PURCHASE
  SALE
  ADJUSTMENT
  DAMAGE
  RETURN
  MANUAL_CORRECTION
  OPENING_STOCK
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum InvoicePaymentStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CHEQUE
  CREDIT_CARD
  DEBIT_CARD
  OTHER
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REVERSED
  REFUNDED
}

enum ExpenseStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  REIMBURSED
  CANCELLED
}

enum LeaveStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
}

enum AnnouncementPriority {
  LOW
  MEDIUM
  HIGH
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum BackupType {
  MANUAL
  SCHEDULED
}

enum BackupStatus {
  PENDING
  IN_PROGRESS
  SUCCESS
  FAILED
}

// ---------------------------------------------------------------------------
// Identity & access control (§21–§24, §51–§53)
// ---------------------------------------------------------------------------

model User {
  id                        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeCode              String     @unique @map("employee_code")
  fullName                  String     @map("full_name")
  email                     String     @unique
  phone                     String?
  passwordManagedBySupabase Boolean    @default(true) @map("password_managed_by_supabase")
  roleId                    String     @map("role_id") @db.Uuid
  department                String?
  designation               String?
  profilePhoto              String?    @map("profile_photo")
  joiningDate               DateTime?  @map("joining_date") @db.Date
  status                    UserStatus @default(ACTIVE)
  lastLoginAt               DateTime?  @map("last_login_at") @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy String?   @map("deleted_by") @db.Uuid
  isDeleted Boolean   @default(false) @map("is_deleted")

  role          Role           @relation(fields: [roleId], references: [id])
  userRoles     UserRole[]
  expenses      Expense[]
  leaveRequests LeaveRequest[]
  notifications Notification[]

  @@index([email])
  @@index([employeeCode])
  @@index([status])
  @@index([roleId])
  @@index([isDeleted])
  @@map("users")
}

model Role {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String  @unique
  description  String?
  isSystemRole Boolean @default(false) @map("is_system_role")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy String?   @map("deleted_by") @db.Uuid
  isDeleted Boolean   @default(false) @map("is_deleted")

  users           User[]
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@index([name])
  @@map("roles")
}

model Permission {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String  @unique
  module      String
  action      String
  description String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]

  @@unique([module, action])
  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

// Reserved for future multi-role assignment (§20). v1 resolves a user's
// effective permissions via `users.role_id`.
model UserRole {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  assignedBy String?  @map("assigned_by") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

// ---------------------------------------------------------------------------
// Customers (§25, §26)
// ---------------------------------------------------------------------------

model Customer {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerCode   String         @unique @map("customer_code")
  customerType   CustomerType   @default(INDIVIDUAL) @map("customer_type")
  companyName    String?        @map("company_name")
  customerName   String         @map("customer_name")
  phone          String
  alternatePhone String?        @map("alternate_phone")
  email          String?
  gstNumber      String?        @map("gst_number")
  panNumber      String?        @map("pan_number")
  aadhaarNumber  String?        @map("aadhaar_number")
  website        String?
  status         CustomerStatus @default(ACTIVE)
  notes          String?

  // Business information (§110, §113, §115)
  industry               String?
  businessSize           String?        @map("business_size")
  paymentTermsDays       Int?           @map("payment_terms_days")
  creditLimit            Decimal        @default(0) @map("credit_limit") @db.Decimal(14, 2)
  preferredContactMethod ContactMethod? @map("preferred_contact_method")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy String?   @map("deleted_by") @db.Uuid
  isDeleted Boolean   @default(false) @map("is_deleted")

  addresses     CustomerAddress[]
  quotations    Quotation[]
  invoices      Invoice[]
  payments      Payment[]
  customerNotes CustomerNote[]

  @@index([customerCode])
  @@index([phone])
  @@index([email])
  @@index([gstNumber])
  @@index([customerName])
  @@index([status])
  @@index([customerType])
  @@index([isDeleted])
  @@map("customers")
}

model CustomerNote {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId String @map("customer_id") @db.Uuid
  content    String

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy String?   @map("deleted_by") @db.Uuid
  isDeleted Boolean   @default(false) @map("is_deleted")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([isDeleted])
  @@map("customer_notes")
}

model CustomerAddress {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId   String      @map("customer_id") @db.Uuid
  addressType  AddressType @map("address_type")
  addressLine1 String      @map("address_line_1")
  addressLine2 String?     @map("address_line_2")
  city         String
  district     String?
  state        String
  country      String      @default("India")
  postalCode   String      @map("postal_code")
  isDefault    Boolean     @default(false) @map("is_default")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy String?   @map("deleted_by") @db.Uuid
  isDeleted Boolean   @default(false) @map("is_deleted")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([addressType])
  @@map("customer_addresses")
}

// ---------------------------------------------------------------------------
// Inventory (§27, §28, §29)
// ---------------------------------------------------------------------------

model Category {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String  @unique
  description  String?
  displayOrder Int     @default(0) @map("display_order")
  isActive     Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy String?   @map("deleted_by") @db.Uuid
  isDeleted Boolean   @default(false) @map("is_deleted")

  products Product[]

  @@index([name])
  @@index([isActive])
  @@map("categories")
}

model Product {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productCode         String        @unique @map("product_code")
  categoryId          String        @map("category_id") @db.Uuid
  productName         String        @map("product_name")
  description         String?
  brand               String?
  model               String?
  unit                String        @default("Nos")
  purchasePrice       Decimal       @default(0) @map("purchase_price") @db.Decimal(14, 2)
  sellingPrice        Decimal       @default(0) @map("selling_price") @db.Decimal(14, 2)
  gstPercentage       Decimal       @default(0) @map("gst_percentage") @db.Decimal(5, 2)
  hsnCode             String?       @map("hsn_code")
  sku                 String?       @unique
  discountPercentage  Decimal       @default(0) @map("discount_percentage") @db.Decimal(5, 2)
  minimumSellingPrice Decimal?      @map("minimum_selling_price") @db.Decimal(14, 2)
  mrp                 Decimal?      @db.Decimal(14, 2)
  minimumStock        Decimal       @default(0) @map("minimum_stock") @db.Decimal(14, 3)
  maximumStock        Decimal?      @map("maximum_stock") @db.Decimal(14, 3)
  reorderLevel        Decimal?      @map("reorder_level") @db.Decimal(14, 3)
  currentStock        Decimal       @default(0) @map("current_stock") @db.Decimal(14, 3)
  imageUrl            String?       @map("image_url")
  datasheetUrl        String?       @map("datasheet_url")
  status              ProductStatus @default(ACTIVE)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy String?   @map("deleted_by") @db.Uuid
  isDeleted Boolean   @default(false) @map("is_deleted")

  category              Category               @relation(fields: [categoryId], references: [id])
  quotationItems        QuotationItem[]
  invoiceItems          InvoiceItem[]
  inventoryTransactions InventoryTransaction[]

  @@index([productCode])
  @@index([productName])
  @@index([categoryId])
  @@index([status])
  @@index([isDeleted])
  @@map("products")
}

model InventoryTransaction {
  id              String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId       String                   @map("product_id") @db.Uuid
  transactionType InventoryTransactionType @map("transaction_type")
  quantity        Decimal                  @db.Decimal(14, 3)
  stockBefore     Decimal                  @map("stock_before") @db.Decimal(14, 3)
  stockAfter      Decimal                  @map("stock_after") @db.Decimal(14, 3)
  referenceType   String?                  @map("reference_type")
  referenceId     String?                  @map("reference_id") @db.Uuid
  remarks         String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid

  product Product @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([transactionType])
  @@index([referenceType, referenceId])
  @@index([createdAt])
  @@map("inventory_transactions")
}

// ---------------------------------------------------------------------------
// Quotations (§30, §31)
// ---------------------------------------------------------------------------

model Quotation {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quotationNumber String          @unique @map("quotation_number")
  customerId      String          @map("customer_id") @db.Uuid
  quotationDate   DateTime        @map("quotation_date") @db.Date
  validUntil      DateTime?       @map("valid_until") @db.Date
  status          QuotationStatus @default(DRAFT)
  subtotal        Decimal         @default(0) @db.Decimal(14, 2)
  discount        Decimal         @default(0) @db.Decimal(14, 2)
  gstAmount       Decimal         @default(0) @map("gst_amount") @db.Decimal(14, 2)
  grandTotal      Decimal         @default(0) @map("grand_total") @db.Decimal(14, 2)
  termsConditions String?         @map("terms_conditions")
  remarks         String?

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy String?   @map("deleted_by") @db.Uuid
  isDeleted Boolean   @default(false) @map("is_deleted")

  customer Customer        @relation(fields: [customerId], references: [id])
  items    QuotationItem[]
  invoices Invoice[]

  @@index([quotationNumber])
  @@index([customerId])
  @@index([status])
  @@index([quotationDate])
  @@index([isDeleted])
  @@map("quotations")
}

model QuotationItem {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quotationId   String  @map("quotation_id") @db.Uuid
  productId     String? @map("product_id") @db.Uuid
  description   String
  quantity      Decimal @db.Decimal(14, 3)
  unitPrice     Decimal @map("unit_price") @db.Decimal(14, 2)
  discount      Decimal @default(0) @db.Decimal(14, 2)
  gstPercentage Decimal @default(0) @map("gst_percentage") @db.Decimal(5, 2)
  lineTotal     Decimal @map("line_total") @db.Decimal(14, 2)
  sortOrder     Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product?  @relation(fields: [productId], references: [id])

  @@index([quotationId])
  @@index([productId])
  @@map("quotation_items")
}

// ---------------------------------------------------------------------------
// Invoices (§32, §33)
// ---------------------------------------------------------------------------

model Invoice {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceNumber   String               @unique @map("invoice_number")
  customerId      String               @map("customer_id") @db.Uuid
  quotationId     String?              @map("quotation_id") @db.Uuid
  invoiceDate     DateTime             @map("invoice_date") @db.Date
  dueDate         DateTime?            @map("due_date") @db.Date
  status          InvoiceStatus        @default(DRAFT)
  paymentStatus   InvoicePaymentStatus @default(UNPAID) @map("payment_status")
  subtotal        Decimal              @default(0) @db.Decimal(14, 2)
  discount        Decimal              @default(0) @db.Decimal(14, 2)
  taxableAmount   Decimal              @default(0) @map("taxable_amount") @db.Decimal(14, 2)
  cgstAmount      Decimal              @default(0) @map("cgst_amount") @db.Decimal(14, 2)
  sgstAmount      Decimal              @default(0) @map("sgst_amount") @db.Decimal(14, 2)
  igstAmount      Decimal              @default(0) @map("igst_amount") @db.Decimal(14, 2)
  gstAmount       Decimal              @default(0) @map("gst_amount") @db.Decimal(14, 2)
  roundOff        Decimal              @default(0) @map("round_off") @db.Decimal(14, 2)
  grandTotal      Decimal              @default(0) @map("grand_total") @db.Decimal(14, 2)
  amountPaid      Decimal              @default(0) @map("amount_paid") @db.Decimal(14, 2)
  balanceDue      Decimal              @default(0) @map("balance_due") @db.Decimal(14, 2)
  placeOfSupply   String?              @map("place_of_supply")
  referenceNumber String?              @map("reference_number")
  reverseCharge   Boolean              @default(false) @map("reverse_charge")
  notes           String?
  termsConditions String?              @map("terms_conditions")
  postedAt        DateTime?            @map("posted_at") @db.Timestamptz(6)
  cancelledAt     DateTime?            @map("cancelled_at") @db.Timestamptz(6)
  cancelReason    String?              @map("cancel_reason")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy String?   @map("deleted_by") @db.Uuid
  isDeleted Boolean   @default(false) @map("is_deleted")

  customer  Customer      @relation(fields: [customerId], references: [id])
  quotation Quotation?    @relation(fields: [quotationId], references: [id])
  items     InvoiceItem[]
  payments  Payment[]

  @@index([invoiceNumber])
  @@index([customerId])
  @@index([quotationId])
  @@index([status])
  @@index([paymentStatus])
  @@index([invoiceDate])
  @@index([dueDate])
  @@index([isDeleted])
  @@map("invoices")
}

model InvoiceItem {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId     String  @map("invoice_id") @db.Uuid
  productId     String? @map("product_id") @db.Uuid
  productName   String  @map("product_name")
  description   String?
  hsnCode       String? @map("hsn_code")
  unit          String  @default("Nos")
  quantity      Decimal @db.Decimal(14, 3)
  unitPrice     Decimal @map("unit_price") @db.Decimal(14, 2)
  discount      Decimal @default(0) @db.Decimal(14, 2)
  gstPercentage Decimal @default(0) @map("gst_percentage") @db.Decimal(5, 2)
  taxableValue  Decimal @default(0) @map("taxable_value") @db.Decimal(14, 2)
  gstAmount     Decimal @default(0) @map("gst_amount") @db.Decimal(14, 2)
  lineTotal     Decimal @map("line_total") @db.Decimal(14, 2)
  sortOrder     Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@index([invoiceId])
  @@index([productId])
  @@map("invoice_items")
}

// ---------------------------------------------------------------------------
// Payments (§34)
// ---------------------------------------------------------------------------

model Payment {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentNumber   String        @unique @map("payment_number")
  invoiceId       String        @map("invoice_id") @db.Uuid
  customerId      String        @map("customer_id") @db.Uuid
  paymentDate     DateTime      @map("payment_date") @db.Date
  paymentMethod   PaymentMethod @map("payment_method")
  status          PaymentStatus @default(SUCCESS)
  referenceNumber String?       @map("reference_number")
  amount          Decimal       @db.Decimal(14, 2)
  remarks         String?

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy String?   @map("deleted_by") @db.Uuid
  isDeleted Boolean   @default(false) @map("is_deleted")

  invoice  Invoice  @relation(fields: [invoiceId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@index([paymentNumber])
  @@index([invoiceId])
  @@index([customerId])
  @@index([status])
  @@index([paymentDate])
  @@index([isDeleted])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Workforce: expenses & leave (§35, §36) + configurable catalogues
// ---------------------------------------------------------------------------

model ExpenseCategory {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String  @unique
  description String?
  isActive    Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy String?   @map("deleted_by") @db.Uuid
  isDeleted Boolean   @default(false) @map("is_deleted")

  expenses Expense[]

  @@index([isActive])
  @@map("expense_categories")
}

model Expense {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  expenseNumber     String        @unique @map("expense_number")
  employeeId        String        @map("employee_id") @db.Uuid
  expenseCategoryId String        @map("expense_category_id") @db.Uuid
  expenseDate       DateTime      @map("expense_date") @db.Date
  amount            Decimal       @db.Decimal(14, 2)
  receiptUrl        String?       @map("receipt_url")
  remarks           String?
  status            ExpenseStatus @default(DRAFT)
  approvedBy        String?       @map("approved_by") @db.Uuid
  approvedAt        DateTime?     @map("approved_at") @db.Timestamptz(6)
  approvalRemarks   String?       @map("approval_remarks")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy String?   @map("deleted_by") @db.Uuid
  isDeleted Boolean   @default(false) @map("is_deleted")

  employee User            @relation(fields: [employeeId], references: [id])
  category ExpenseCategory @relation(fields: [expenseCategoryId], references: [id])

  @@index([expenseNumber])
  @@index([employeeId])
  @@index([expenseCategoryId])
  @@index([status])
  @@index([expenseDate])
  @@index([isDeleted])
  @@map("expenses")
}

model LeaveType {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String  @unique
  code             String  @unique
  description      String?
  isPaid           Boolean @default(true) @map("is_paid")
  requiresDocument Boolean @default(false) @map("requires_document")
  isActive         Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy String?   @map("deleted_by") @db.Uuid
  isDeleted Boolean   @default(false) @map("is_deleted")

  leaveRequests LeaveRequest[]

  @@index([isActive])
  @@map("leave_types")
}

model LeaveRequest {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leaveNumber  String      @unique @map("leave_number")
  employeeId   String      @map("employee_id") @db.Uuid
  leaveTypeId  String      @map("leave_type_id") @db.Uuid
  fromDate     DateTime    @map("from_date") @db.Date
  toDate       DateTime    @map("to_date") @db.Date
  totalDays    Decimal     @default(0) @map("total_days") @db.Decimal(5, 1)
  reason       String
  documentUrl  String?     @map("document_url")
  status       LeaveStatus @default(DRAFT)
  approvedBy   String?     @map("approved_by") @db.Uuid
  approvalDate DateTime?   @map("approval_date") @db.Timestamptz(6)
  remarks      String?

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy String?   @map("deleted_by") @db.Uuid
  isDeleted Boolean   @default(false) @map("is_deleted")

  employee  User      @relation(fields: [employeeId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@index([leaveNumber])
  @@index([employeeId])
  @@index([leaveTypeId])
  @@index([status])
  @@index([fromDate])
  @@index([isDeleted])
  @@map("leave_requests")
}

// ---------------------------------------------------------------------------
// Communication (§37, §38)
// ---------------------------------------------------------------------------

model Announcement {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String
  description  String
  priority     AnnouncementPriority @default(MEDIUM)
  publishDate  DateTime?            @map("publish_date") @db.Timestamptz(6)
  expiryDate   DateTime?            @map("expiry_date") @db.Timestamptz(6)
  isPublished  Boolean              @default(false) @map("is_published")
  visibleRoles String[]             @map("visible_roles")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy String?   @map("deleted_by") @db.Uuid
  isDeleted Boolean   @default(false) @map("is_deleted")

  @@index([priority])
  @@index([isPublished])
  @@index([publishDate])
  @@index([isDeleted])
  @@map("announcements")
}

model Notification {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipientUserId String           @map("recipient_user_id") @db.Uuid
  title           String
  message         String
  type            NotificationType @default(INFO)
  readStatus      Boolean          @default(false) @map("read_status")
  redirectUrl     String?          @map("redirect_url")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)

  recipient User @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([recipientUserId])
  @@index([readStatus])
  @@index([createdAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Logs — append-only & immutable (§39, §40)
// ---------------------------------------------------------------------------

model ActivityLog {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String? @map("user_id") @db.Uuid
  activity    String
  module      String
  referenceId String? @map("reference_id") @db.Uuid
  ipAddress   String? @map("ip_address")
  device      String?
  browser     String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([module])
  @@index([createdAt])
  @@map("activity_logs")
}

model AuditLog {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String? @map("user_id") @db.Uuid
  action      String
  module      String
  referenceId String? @map("reference_id") @db.Uuid
  oldValue    Json?   @map("old_value")
  newValue    Json?   @map("new_value")
  ipAddress   String? @map("ip_address")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([module])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// System (§41, §42, §43)
// ---------------------------------------------------------------------------

model SystemSetting {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  settingKey   String  @unique @map("setting_key")
  settingValue Json    @map("setting_value")
  category     String  @default("general")
  description  String?
  isPublic     Boolean @default(false) @map("is_public")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.Uuid

  @@index([settingKey])
  @@index([category])
  @@map("system_settings")
}

model BackupHistory {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  backupName      String       @map("backup_name")
  backupType      BackupType   @default(MANUAL) @map("backup_type")
  fileSize        BigInt?      @map("file_size")
  storageLocation String?      @map("storage_location")
  status          BackupStatus @default(PENDING)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid

  @@index([status])
  @@index([createdAt])
  @@map("backup_history")
}

model SystemHealthLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cpuUsage       Decimal? @map("cpu_usage") @db.Decimal(5, 2)
  memoryUsage    Decimal? @map("memory_usage") @db.Decimal(5, 2)
  databaseStatus String?  @map("database_status")
  storageUsage   Decimal? @map("storage_usage") @db.Decimal(5, 2)
  activeUsers    Int?     @map("active_users")
  responseTime   Int?     @map("response_time")

  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)

  @@index([recordedAt])
  @@map("system_health_logs")
}

/// Atomic counters for human-readable entity codes (spec §107 — codes are
/// never reused; gaps are acceptable). Incremented via a locking UPDATE inside
/// the same transaction as the record it numbers.
model NumberSequence {
  key       String @id
  prefix    String
  padding   Int    @default(6)
  nextValue Int    @default(1) @map("next_value")

  @@map("number_sequences")
}
